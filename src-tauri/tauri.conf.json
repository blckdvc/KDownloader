{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KDownloader",
  "version": "0.2.0",
  "identifier": "com.kdownloader.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KDownloader",
        "width": 1040,
        "height": 700,
        "minWidth": 740,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "torrent"
        ],
        "name": "BitTorrent file",
        "role": "Viewer",
        "rank": "Default",
        "contentTypes": [
          "org.bittorrent.torrent"
        ]
      }
    ]
  },
  "plugins": {}
}
